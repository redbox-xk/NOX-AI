ssh root@#!/usr/bin/env python3
"""
NOX CHAIN NATIVE - Complete Blockchain with NOX Language Support
Run in Windows CMD: python nox_chain_native.py
"""
import hashlib
import json
import time
import threading
import socket
import requests
import random
import sys
import os
from datetime import datetime
from typing import Dict, List, Any, Optional, Tuple
import base64
import pickle
import sqlite3
import argparse
from dataclasses import dataclass, asdict, field
from collections import OrderedDict
import uuid
import re
import ast
import traceback
# ============================================
# NOX LANGUAGE PARSER & COMPILER
# ============================================
class NOXType:
    SCALAR = 'scalar'
    INT = 'int'
    BOOL = 'bool'
    HASH = 'hash'
    ENTITY = 'entity'
    FIELD = 'field'
    STRING = 'string'
    
    @staticmethod
    def validate(value, type_name):
        if type_name == NOXType.SCALAR:
            return isinstance(value, (int, float)) and value >= 0
        elif type_name == NOXType.INT:
            return isinstance(value, int)
        elif type_name == NOXType.BOOL:
            return isinstance(value, bool)
        elif type_name == NOXType.HASH:
            return isinstance(value, str) and len(value) == 64
        elif type_name == NOXType.ENTITY:
            return isinstance(value, str) and value.startswith('entity_')
        elif type_name == NOXType.FIELD:
            return isinstance(value, str) and value.startswith('field_')
        elif type_name == NOXType.STRING:
            return isinstance(value, str)
        return False
class NOXValue:
    def __init__(self, value, type_name):
        self.value = value
        self.type = type_name
        if not NOXType.validate(value, type_name):
            raise ValueError(f"Invalid value {value} for type {type_name}")
    
    def __repr__(self):
        return f"{self.type}({self.value})"
    
    def to_dict(self):
        return {'type': self.type, 'value': self.value}
class NOXAST:
    """NOX Language Abstract Syntax Tree"""
    
    class Node:
        pass
    
    class Program(Node):
        def __init__(self):
            self.states = []
            self.constraints = []
            self.invariants = []
            self.views = []
    
    class State(Node):
        def __init__(self, name, fields):
            self.name = name
            self.fields = fields  # [(name, type, is_public)]
            self.init = []
    
    class Constraint(Node):
        def __init__(self, name, params, body):
            self.name = name
            self.params = params  # [(name, type)]
            self.body = body
    
    class Invariant(Node):
        def __init__(self, name, expr):
            self.name = name
            self.expr = expr
    
    class View(Node):
        def __init__(self, name, params, return_type, body):
            self.name = name
            self.params = params
            self.return_type = return_type
            self.body = body
    
    class Expr(Node):
        pass
    
    class Literal(Expr):
        def __init__(self, value):
            self.value = value
    
    class Var(Expr):
        def __init__(self, name):
            self.name = name
    
    class BinaryOp(Expr):
        def __init__(self, left, op, right):
            self.left = left
            self.op = op
            self.right = right
    
    class UnaryOp(Expr):
        def __init__(self, op, expr):
            self.op = op
            self.expr = expr
    
    class Call(Expr):
        def __init__(self, name, args):
            self.name = name
            self.args = args
    
    class MapGet(Expr):
        def __init__(self, map_expr, key_expr):
            self.map = map_expr
            self.key = key_expr
    
    class If(Expr):
        def __init__(self, cond, then_expr, else_expr):
            self.cond = cond
            self.then_expr = then_expr
            self.else_expr = else_expr
    
    class Stmt(Node):
        pass
    
    class Require(Stmt):
        def __init__(self, expr):
            self.expr = expr
