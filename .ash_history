#!/bin/bash
# setup_repo.sh - Complete repository setup script
set -e
echo "🚀 Creating Universal Crypto Wallet Finder Repository..."
# Create main directory
mkdir -p universal-crypto-finder
cd universal-crypto-finder
# Create directory structure
mkdir -p {src,config,data,logs,output,scripts,tests,docs,examples}
mkdir -p src/{core,generators,checkers,intelligence,utils}
mkdir -p output/{found_wallets,reports,backups}
mkdir -p config/{chains,patterns}
mkdir -p tests/{unit,integration}
mkdir -p docs/{api,guides,examples}
# ============================================
# MAIN APPLICATION FILES
# ============================================
# Main entry point
cat > main.py << 'EOF'
#!/usr/bin/env python3
"""
Universal Crypto Wallet Finder - Main Entry Point
Multi-chain wallet scanner with intelligent pattern recognition
"""
import sys
import os
import argparse
from src.core.scanner import UniversalScanner
from src.utils.logger import setup_logger
from src.utils.config import load_config
from src.utils.banner import show_banner
def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description='Universal Crypto Wallet Finder - Multi-chain scanner',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s --chains all --threads 100
  %(prog)s --chains btc eth sol --duration 3600
  %(prog)s --chains eth --min-balance 0.01 --output my_wallets
        """
    )
    
    parser.add_argument('--chains', '-c', nargs='+', 
                       choices=['btc', 'eth', 'bnb', 'base', 'sol', 'all'],
                       default=['eth'], help='Chains to scan (default: eth)')
    
    parser.add_argument('--threads', '-t', type=int, default=50,
                       help='Number of worker threads (default: 50)')
    
    parser.add_argument('--duration', '-d', type=int,
                       help='Scan duration in seconds (default: unlimited)')
    
    parser.add_argument('--min-balance', '-m', type=float, default=0.000001,
                       help='Minimum balance to report in native currency (default: 0.000001)')
    
    parser.add_argument('--output', '-o', default='./output',
                       help='Output directory (default: ./output)')
    
    parser.add_argument('--config', '-cfg', default='config/config.yaml',
                       help='Configuration file (default: config/config.yaml)')
    
    parser.add_argument('--smart-mode', action='store_true',
                       help='Enable intelligent pattern-based generation')
    
    parser.add_argument('--target-rich', action='store_true',
                       help='Target known rich address patterns')
    
    parser.add_argument('--verbose', '-v', action='store_true',
                       help='Enable verbose output')
    
    parser.add_argument('--version', action='version', 
                       version='Universal Crypto Wallet Finder v4.0')
    
    args = parser.parse_args()
    
    # Setup logging
    logger = setup_logger(args.verbose)
    
    # Show banner
    show_banner()
    
    # Load configuration
    config = load_config(args.config)
    
    # Parse chains
    if 'all' in args.chains:
        chains = ['btc', 'eth', 'bnb', 'base', 'sol']
    else:
        chains = args.chains
    
    logger.info(f"🚀 Starting scanner on chains: {', '.join(c.upper() for c in chains)}")
    logger.info(f"📡 Threads: {args.threads}")
    logger.info(f"🎯 Min balance: {args.min_balance}")
    logger.info(f"📁 Output directory: {args.output}")
    
    # Create output directory
    os.makedirs(args.output, exist_ok=True)
    os.makedirs(f"{args.output}/found_wallets", exist_ok=True)
    
    # Initialize and run scanner
    scanner = UniversalScanner(
        chains=chains,
        threads=args.threads,
        min_balance=args.min_balance,
        output_dir=args.output,
        config=config,
        smart_mode=args.smart_mode,
        target_rich=args.target_rich
    )
    
    try:
        scanner.run(args.duration)
    except KeyboardInterrupt:
        logger.in
EOF
