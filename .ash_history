#!/bin/bash
# push_nox_ai_https.sh - Complete NOX-AI Project Push via HTTPS
set -e
# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'
echo -e "${CYAN}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                                                              ║"
echo "║          NOX-AI PROJECT GENERATOR & HTTPS PUSHER             ║"
echo "║                                                              ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${NC}"
# ============================================
# CONFIGURATION
# ============================================
REPO_URL="https://github.com/redbox-xk/NOX-AI.git"
CLONE_DIR="/tmp/nox-ai-clone"
PROJECT_FINAL_DIR="$HOME/NOX-AI"
# ============================================
# STEP 1: Clean up any old clones
# ============================================
echo -e "\n${YELLOW}[1/6] Cleaning up old temporary directories...${NC}"
rm -rf "$CLONE_DIR"
rm -rf "$PROJECT_FINAL_DIR"
# ============================================
# STEP 2: Clone the existing repository (HTTPS)
# ============================================
echo -e "\n${YELLOW}[2/6] Cloning repository via HTTPS...${NC}"
git clone "$REPO_URL" "$CLONE_DIR"
cd "$CLONE_DIR"
# Check if it's empty and has the first commit
if [ ! -f "README.md" ]; then
    echo -e "${RED}Error: Repository seems empty or inaccessible.${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Repository cloned successfully.${NC}"
# ============================================
# STEP 3: Generate the complete project files
# ============================================
echo -e "\n${YELLOW}[3/6] Generating full NOX-AI project files...${NC}"
# Create directory structure
mkdir -p src/{core,generators,checkers,intelligence,utils}
mkdir -p output/found_wallets
mkdir -p logs
mkdir -p config
mkdir -p scripts
mkdir -p tests
# Generate main.py
cat > main.py << 'EOF'
